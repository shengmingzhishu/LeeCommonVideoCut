# cut-server 环境变量样例
# 复制为 .env 后按需修改；真实 .env 不要提交到 git

# ===== 数据库（PostgreSQL 18 · 本地已装） =====
DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/cut_video

# ===== JWT 鉴权 =====
JWT_SECRET=please-change-me-in-production
JWT_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ===== TTS 语音合成 =====
TTS_DEFAULT_ENGINE=edge-tts

# ===== AI 大模型（MiniMax M3 · OpenAI 兼容协议） =====
AI_PROVIDER=minimax
# 真实 Key 写到本地 .env（已加入 .gitignore），本文件只保留变量名
MINIMAX_API_KEY=sk-cp-PUT-YOUR-REAL-KEY-HERE
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3

# ===== 网络搜索 =====
SEARCH_ENGINE=duckduckgo
BING_SEARCH_KEY=

# ===== 通用 =====
WORKDIR=./workspace
LOG_LEVEL=INFO
LOG_JSON=true

# ===== 首次启动引导（首个管理员） =====
# 当 users 表为空时，根据这两个变量创建第一个管理员
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123456