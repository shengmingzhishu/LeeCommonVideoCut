import os


def _get_bool_env(name: str, default: bool) -> bool:
    value = os.getenv(name)
    if value is None:
        return default
    return value.strip().lower() in {'1', 'true', 'yes', 'on'}

PROJECT_NAME='{{ project_name }}'

# controller对外提供接口及ip
SERVER_PORT = int(os.getenv('SERVER_PORT', '8088'))
SERVER_IP = os.getenv('SERVER_IP', '0.0.0.0')

DB_ENGINE_URL="mysql+pymysql://username:password@host:port/db?charset=utf8mb4"

# 数据库配置
DATABASE_CONFIG = {
    'db_engine_url': os.getenv('DB_ENGINE_URL', DB_ENGINE_URL),
    'engine_setting': {
        'echo': bool(False),  # 打印 sqlalchemy输出
        'echo_pool': bool(False),
        'pool_pre_ping': _get_bool_env('DB_POOL_PRE_PING', True),
        # 设置7*60*60秒后回收连接池，默认-1，从不重置，8小时为mysql默认的连接回收时长，有指定的错误提示。
        'pool_recycle': int(os.getenv('DB_POOL_RECYCLE', '25200')),
        'pool_size': int(os.getenv('DB_POOL_SIZE', '10')),
        'max_overflow': int(os.getenv('DB_MAX_OVERFLOW', '20')),
    },
}

